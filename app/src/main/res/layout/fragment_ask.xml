<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/auth_screen_padding_horizontal"
        android:paddingTop="@dimen/auth_screen_padding_vertical"
        android:paddingBottom="@dimen/auth_screen_padding_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ask_title"
            android:textColor="@color/auth_foreground"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_title_margin_top"
            android:text="@string/ask_subtitle"
            android:textColor="@color/auth_muted_foreground"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edit_question"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/auth_form_margin_top"
            android:background="@drawable/bg_auth_input"
            android:gravity="top|start"
            android:hint="@string/ask_hint"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="@color/auth_foreground"
            android:textColorHint="@color/auth_muted_foreground"
            android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layout_image_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/img_preview"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/ask_image_preview"
                    android:scaleType="centerCrop" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_remove_image"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/ask_remove_image"
                    android:textColor="@color/auth_muted_foreground" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_camera"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/ask_camera"
                    android:textColor="@color/auth_foreground"
                    app:strokeColor="@color/auth_input_ring" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_gallery"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/ask_gallery"
                    android:textColor="@color/auth_foreground"
                    app:strokeColor="@color/auth_input_ring" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ask_send"
                    app:backgroundTint="@color/auth_brand"
                    app:cornerRadius="24dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_loading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/auth_brand"
                android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/ask_suggestions_title"
            android:textColor="@color/auth_foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_suggestion_1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="start|center_vertical"
            android:text="@string/ask_suggestion_1"
            android:textColor="@color/auth_foreground"
            app:cornerRadius="@dimen/auth_input_radius"
            app:strokeColor="@color/auth_input_ring" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_suggestion_2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="@string/ask_suggestion_2"
            android:textColor="@color/auth_foreground"
            app:cornerRadius="@dimen/auth_input_radius"
            app:strokeColor="@color/auth_input_ring" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_suggestion_3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="@string/ask_suggestion_3"
            android:textColor="@color/auth_foreground"
            app:cornerRadius="@dimen/auth_input_radius"
            app:strokeColor="@color/auth_input_ring" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_suggestion_4"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="@string/ask_suggestion_4"
            android:textColor="@color/auth_foreground"
            app:cornerRadius="@dimen/auth_input_radius"
            app:strokeColor="@color/auth_input_ring" />

    </LinearLayout>
</ScrollView>
